# Configuração do coletor externo. Copie para .env (que NÃO é commitado).
# Nenhuma credencial de portal vive no código; o login é MANUAL no Chrome real
# (ver README › Fluxo do operador). No modo CDP recomendado não há senha aqui.

# Transporte CDP — porta do --remote-debugging-port do seu Chrome real
CDP_PORT=9222

# Ritmo e volume
CONCURRENCY=6
PAGE_LIMIT=200
SLEEP_MS=400

# Saída e retomada
OUT_DIR=./out
CHECKPOINT_EVERY=2000

# Canário (portão do full) e sharding
CANARY_STEPS=1,10,100,1000
SHARD_MAX=9500

# Override de sessão só para depuração (deixe vazio no uso normal)
SESSION_ID_OVERRIDE=

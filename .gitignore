# Segredos — .env é GERADO (op inject -i .env.tmpl -o .env), nunca commitado
.env

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# macOS
.DS_Store

# Artefatos locais de planilha e saída de rodada
*.xlsx
*.csv
saida/

# Node (coletor-externo, TypeScript)
node_modules/
coletor-externo/out/
coletor-externo/tmp/
# O coletor produz CSV (contrato de saída); fixtures de teste são exceção ao *.csv global acima
!coletor-externo/test/fixtures/
!coletor-externo/test/fixtures/*.csv

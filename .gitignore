# Segredos — .env é GERADO (op inject -i .env.tmpl -o .env), nunca commitado
.env

# Worktrees de sessão. Escopo deliberado em `.claude/worktrees/`, NUNCA `.claude/`:
# `agents/` e `skills/` são rastreados e são estrutura do repo (CLAUDE.md).
.claude/worktrees/

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# macOS
.DS_Store

# Artefatos locais de planilha e saída de rodada
*.xlsx
*.csv
saida/

# Node (coletor-externo, TypeScript)
node_modules/
coletor-externo/out/
coletor-externo/tmp/
